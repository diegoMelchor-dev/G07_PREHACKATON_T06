<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="participantes_por_institucion"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="25"
              whenNoDataType="NoDataSection">

    <!-- Reporte de Participantes por Institución (Integrante 2).
         Agrupado por institución con subtotal por grupo y total
         general. Los datos se llenan desde ParticipanteDAO con un
         JRBeanCollectionDataSource. -->

    <property name="net.sf.jasperreports.report.name"
              value="Reporte de Participantes por Institución"/>

    <field name="idParticipante" class="java.lang.Integer"/>
    <field name="nombres" class="java.lang.String"/>
    <field name="apellidos" class="java.lang.String"/>
    <field name="dni" class="java.lang.String"/>
    <field name="correo" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="institucion" class="java.lang.String"/>

    <!-- Subtotal de participantes de la institución actual -->
    <variable name="totalGrupo" class="java.lang.Integer"
              resetType="Group" resetGroup="institucionGrupo"
              calculation="Count">
        <variableExpression><![CDATA[$F{dni}]]></variableExpression>
    </variable>

    <!-- Total general de participantes -->
    <variable name="totalGeneral" class="java.lang.Integer"
              calculation="Count">
        <variableExpression><![CDATA[$F{dni}]]></variableExpression>
    </variable>

    <group name="institucionGrupo">
        <groupExpression><![CDATA[$F{institucion}]]></groupExpression>
        <groupHeader>
            <band height="26">
                <staticText>
                    <reportElement mode="Opaque" x="0" y="0"
                                   width="555" height="22"
                                   backcolor="#DDE6F5" forecolor="#1F3B73"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="DejaVu Sans" size="11"
                              isBold="true"/>
                    </textElement>
                    <text><![CDATA[  INSTITUCIÓN:]]></text>
                </staticText>
                <textField>
                    <reportElement x="120" y="0" width="435" height="22"
                                   forecolor="#1F3B73"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="DejaVu Sans" size="11"
                              isBold="true"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA[$F{institucion}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="24">
                <line>
                    <reportElement x="0" y="1" width="555" height="1"
                                   forecolor="#B9C4D6"/>
                    <graphicElement>
                        <pen lineWidth="0.5" lineColor="#B9C4D6"/>
                    </graphicElement>
                </line>
                <textField>
                    <reportElement mode="Opaque" x="0" y="3"
                                   width="555" height="18"
                                   backcolor="#F2F5FA" forecolor="#1F3B73"/>
                    <textElement textAlignment="Right"
                                 verticalAlignment="Middle">
                        <font fontName="DejaVu Sans" size="9"
                              isBold="true"/>
                    </textElement>
                    <textFieldExpression class="java.lang.String"><![CDATA["Subtotal — participantes de esta institución: " + $V{totalGrupo}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="92">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0"
                               width="555" height="46"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="16"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Participantes por Institución]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="48" width="555" height="16"
                               forecolor="#5A6472"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <text><![CDATA[Sistema de Gestión de Eventos y Conferencias]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="66" width="555" height="16"
                               forecolor="#5A6472"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Generado el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0"
                               width="32" height="22"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[N°]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="34" y="0"
                               width="124" height="22"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[Apellidos]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="160" y="0"
                               width="100" height="22"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[Nombres]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="262" y="0"
                               width="55" height="22"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[DNI]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="319" y="0"
                               width="140" height="22"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[Correo]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="461" y="0"
                               width="94" height="22"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[Teléfono]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="32" height="16"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.Integer"><![CDATA[$F{idParticipante}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="34" y="0" width="124" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{apellidos}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="100" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{nombres}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="262" y="0" width="55" height="16"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{dni}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="319" y="0" width="140" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{correo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="461" y="0" width="94" height="16"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{telefono}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="350" height="16"
                               forecolor="#5A6472"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <text><![CDATA[Módulo Participantes — Integrante 2]]></text>
            </staticText>
            <textField>
                <reportElement x="450" y="0" width="85" height="16"
                               forecolor="#5A6472"/>
                <textElement textAlignment="Right"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="538" y="0" width="17" height="16"
                               forecolor="#5A6472"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.Integer"><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="30">
            <textField>
                <reportElement mode="Opaque" x="0" y="0"
                               width="555" height="24"
                               backcolor="#1F3B73" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10"
                          isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["TOTAL GENERAL DE PARTICIPANTES: " + $V{totalGeneral}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="40"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[No hay participantes registrados.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
